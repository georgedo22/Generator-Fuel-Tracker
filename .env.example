# Render PostgreSQL (External connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Session signing secret (use a long random string in production)
JWT_SECRET="change-this-to-a-long-random-secret-string"

# Directory where generator images are stored
# Production on Render: mount a Disk at /var/data and use /var/data/uploads
UPLOAD_DIR="./public/uploads"